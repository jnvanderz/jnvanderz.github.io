        cmd(m, C, "URL Encode", lambda: self.codec_tool("urle"))
        cmd(m, C, "URL Decode", lambda: self.codec_tool("urld"))
        sub = submenu(m, "Hash")
        for algo in ("MD5", "SHA-1", "SHA-256"):
            cmd(sub, C, f"Hash: {algo}", lambda a=algo: self.show_hash(a))
            sub.entryconfigure("end", label=algo)
        cmd(m, C, "Calculate Selection", self.calculate)
        m.add_separator()
        cmd(m, C, "Edit Snippets", self.edit_snippets)

        C = "Run"
        m = cascade(C)
        cmd(m, C, "Run File", self.run_file, "Ctrl+R")
        cmd(m, C, "Stop", self.stop_run)
        m.add_separator()
        cmd(m, C, "Preview in Browser", self.preview, "Ctrl+Shift+V")

        if not self.zen:
            self.root.config(menu=mb)

    def _build_context_menu(self):
        m = tk.Menu(self.root, tearoff=0)
        for label, event in (("Undo", "<<Undo>>"), ("Redo", "<<Redo>>"), (None, None),
                             ("Cut", "<<Cut>>"), ("Copy", "<<Copy>>"),
                             ("Paste", "<<Paste>>"), ("Delete", "<<Clear>>")):
            if label is None:
                m.add_separator()
            else:
                m.add_command(label=label, command=lambda ev=event: self._text_event(ev))
        m.add_separator()
        m.add_command(label="Select All", command=self.select_all)
        m.add_command(label="Toggle Comment", command=self.toggle_comment)
        m.add_command(label="Toggle Bookmark", command=self.toggle_bookmark)
        self.context_menu = m

