def detect_language(path):
    if not path:
        return None
    ext = os.path.splitext(path)[1].lower().lstrip(".")
    if not ext:  # files such as ".bashrc" or ".gitconfig"
        ext = os.path.basename(path).lower().lstrip(".")
    return EXTENSIONS.get(ext)


