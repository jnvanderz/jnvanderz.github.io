        cmd(m, C, "Title Case", lambda: self.change_case("title"))
        m.add_separator()
        cmd(m, C, "Sort Lines", self.sort_lines)
        cmd(m, C, "Remove Duplicate Lines", self.unique_lines)
        cmd(m, C, "Trim Trailing Spaces", self.trim_trailing)
