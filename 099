        m.add_separator()
        cmd(m, C, "Command Palette...", self.command_palette, "Ctrl+Shift+P")

        C = "Encoding"
        m = cascade(C)
        for enc in ENCODINGS:
            radio(m, C, "Save with Encoding", "Save as {enc}".format(enc=enc),
                  self.enc_var, enc, self.set_encoding)
        m.add_separator()
        sub = submenu(m, "Reopen with Encoding")
        for enc in ENCODINGS:
            cmd(sub, C, f"Reopen with Encoding: {enc}",
