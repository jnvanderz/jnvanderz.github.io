def decode_bytes(data, forced=None):
    """Return (text, encoding). BOMs are detected first; latin-1 always succeeds."""
    if forced:
        return data.decode(forced, errors="replace"), forced
    if data.startswith(codecs.BOM_UTF8):
        return data[len(codecs.BOM_UTF8):].decode("utf-8", errors="replace"), "utf-8-sig"
    if data.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
        return data.decode("utf-16", errors="replace"), "utf-16"
    for enc in ("utf-8", "cp1252"):
        try:
            return data.decode(enc), enc
        except UnicodeDecodeError:
            continue
    return data.decode("latin-1"), "latin-1"


def detect_eol(text):
    if "\r\n" in text:
        return "\r\n"
    if "\r" in text:
        return "\r"
    if "\n" in text:
        return "\n"
    return DEFAULT_EOL


class ProxyText(tk.Text):
    """Text widget that reports content and cursor changes."""

    def __init__(self, master, **kw):
        super().__init__(master, **kw)
        self.on_change = None
        self.on_cursor = None
        self._orig = self._w + "_orig"
        self.tk.call("rename", self._w, self._orig)
        self.tk.createcommand(self._w, self._proxy)

    def _proxy(self, *args):
        try:
            result = self.tk.call((self._orig,) + args)
        except tk.TclError:
            return ""
        cmd = args[0] if args else ""
        changed = cmd in ("insert", "delete", "replace") or (
            cmd == "edit" and len(args) > 1 and args[1] in ("undo", "redo"))
        moved = changed or (cmd == "mark" and len(args) > 2
                            and args[1] == "set" and args[2] == "insert")
        if changed and self.on_change:
            self.on_change()
        if moved and self.on_cursor:
            self.on_cursor()
        return result

    def destroy(self):
        super().destroy()
        try:
            self.tk.deletecommand(self._w)
        except tk.TclError:
            pass


class Document:
    """One tab: text area, line-number gutter and file metadata."""

    def __init__(self, app, title):
        self.app = app
        self.id = uuid.uuid4().hex
        self.title = title
        self.path = None
        self.encoding = "utf-8"
        self.eol = DEFAULT_EOL
        self.mtime = None
        self.lang = None
        self.words = 0
        self.chars = 0
        self._refresh_job = None
        self._lines_job = None
        self._cursor_job = None

        self.frame = tk.Frame(app.nb, bd=0)
        self.gutter = tk.Canvas(self.frame, width=40, bd=0, highlightthickness=0)
        self.text = ProxyText(self.frame, wrap="word" if app.wrap.get() else "none",
                              undo=True, maxundo=-1, font=app.font,
                              borderwidth=0, highlightthickness=0, padx=8, pady=6)
        self.sy = tk.Scrollbar(self.frame, orient="vertical", command=self.text.yview)
        self.sx = tk.Scrollbar(self.frame, orient="horizontal", command=self.text.xview)
        self.text.configure(yscrollcommand=self._on_yscroll, xscrollcommand=self.sx.set)

        self.gutter.grid(row=0, column=0, sticky="ns")
        self.text.grid(row=0, column=1, sticky="nsew")
        self.sy.grid(row=0, column=2, sticky="ns")
        self.sx.grid(row=1, column=1, sticky="ew")
        self.frame.rowconfigure(0, weight=1)
        self.frame.columnconfigure(1, weight=1)
        if not app.line_numbers.get():
            self.gutter.grid_remove()

        for name in TOKEN_GROUP_NAMES:
            self.text.tag_configure("tok_" + name)
        self.text.tag_configure("bracket")
        self.text.tag_raise("bracket")
        self.text.tag_raise("sel")
        self.apply_theme()

        self.text.on_change = self._on_change
        self.text.on_cursor = self._on_cursor

        t = self.text
        t.bind("<<Modified>>", lambda e: app.update_tab(self))
        t.bind("<Return>", self._on_return)
        t.bind("<KP_Enter>", self._on_return)
        t.bind("<Control-MouseWheel>", app.on_ctrl_wheel)
        t.bind("<Control-Button-4>", app.on_ctrl_wheel)
        t.bind("<Control-Button-5>", app.on_ctrl_wheel)
        t.bind("<Button-2>" if app.aqua else "<Button-3>", app.show_context_menu)
        self.gutter.bind("<MouseWheel>", self._gutter_wheel)
        self.gutter.bind("<Button-4>", lambda e: self.text.yview_scroll(-3, "units"))
        self.gutter.bind("<Button-5>", lambda e: self.text.yview_scroll(3, "units"))
        app.bind_shortcuts(t)

    # ---- info ----
    def name(self):
        return os.path.basename(self.path) if self.path else self.title

    def modified(self):
        return bool(self.text.edit_modified())

    def content(self):
        return self.text.get("1.0", "end-1c")

    def is_blank(self):
        return self.path is None and not self.modified() and not self.content()

    # ---- content ----
    def set_content(self, content):
        t = self.text
        t.delete("1.0", "end")
        t.insert("1.0", content)
        t.edit_reset()
        t.edit_modified(False)
        t.mark_set("insert", "1.0")
        t.see("1.0")

    def load(self, path, content, encoding, size):
        self.eol = detect_eol(content)
        content = content.replace("\r\n", "\n").replace("\r", "\n")
        self.path = path
        self.encoding = encoding
        try:
            self.mtime = os.path.getmtime(path)
        except OSError:
            self.mtime = None
        self.set_content(content)
        self.setup_lexer()
        self.app.update_tab(self)
        lines = content.count("\n") + 1
        self.app.set_message(f"{path}   |   {lines:,} lines   |   {size:,} bytes")

    def setup_lexer(self):
        self.lang = detect_language(self.path)
        self.schedule_refresh(0)

    # ---- appearance ----
    def apply_theme(self):
        th = self.app.theme
        self.text.config(bg=th["bg"], fg=th["fg"], insertbackground=th["cursor"],
                         selectbackground=th["sel_bg"], selectforeground=th["sel_fg"],
                         inactiveselectbackground=th["sel_bg"])
        self.frame.config(bg=th["bg"])
        self.gutter.config(bg=th["gutter_bg"])
        self.text.tag_configure("bracket", background=th["bracket"])
        for name in TOKEN_GROUP_NAMES:
            self.text.tag_configure("tok_" + name, foreground=th[name])
        self.redraw_gutter()

    def redraw_gutter(self):
        if not self.app.line_numbers.get():
            return
        g, t = self.gutter, self.text
        last = int(t.index("end-1c").split(".")[0])
        width = self.app.font.measure("0" * max(3, len(str(last)))) + 14
        if int(g.cget("width")) != width:
            g.config(width=width)
        g.delete("all")
        fill = self.app.theme["gutter_fg"]
        first = int(t.index("@0,0").split(".")[0])
        drawn = False
        for n in range(first, last + 1):
            info = t.dlineinfo(f"{n}.0")
            if info is None:
                if drawn:
                    break
                continue
            drawn = True
            g.create_text(width - 6, info[1], anchor="ne", text=str(n),
                          font=self.app.font, fill=fill)

    def highlight(self):
        t = self.text
        for name in TOKEN_GROUP_NAMES:
            t.tag_remove("tok_" + name, "1.0", "end")
        if not (self.lang and self.app.highlight.get()):
            return
        content = self.content()
        if len(content) > HIGHLIGHT_LIMIT:
            return
        starts = [0]
        pos = content.find("\n")
        while pos != -1:
            starts.append(pos + 1)
            pos = content.find("\n", pos + 1)

        def index(offset):
            line = bisect.bisect_right(starts, offset) - 1
            return f"{line + 1}.{offset - starts[line]}"

        ranges = {}
        for m in LANGUAGES[self.lang].finditer(content):
            if m.end() > m.start():
                group = m.lastgroup.rsplit("_", 1)[0]
                ranges.setdefault(group, []).extend((index(m.start()), index(m.end())))
        for group, idx in ranges.items():
            for i in range(0, len(idx), 2000):
                t.tag_add("tok_" + group, *idx[i:i + 2000])

    def match_brackets(self):
        t = self.text
        t.tag_remove("bracket", "1.0", "end")
        opens = {"(": ")", "[": "]", "{": "}"}
        closes = {v: k for k, v in opens.items()}
        for idx in ("insert-1c", "insert"):
            ch = t.get(idx)
            if ch in opens or ch in closes:
                break
        else:
            return
        pos = t.index(idx)
        other = None
        depth = 0
        if ch in opens:
            close = opens[ch]
            for i, c in enumerate(t.get(pos, f"{pos}+{BRACKET_LIMIT}c")):
                if c == ch:
                    depth += 1
                elif c == close:
                    depth -= 1
                    if depth == 0:
                        other = f"{pos}+{i}c"
                        break
        else:
            open_ = closes[ch]
            chunk = t.get(f"{pos}-{BRACKET_LIMIT}c", f"{pos}+1c")
            for i, c in enumerate(reversed(chunk)):
                if c == ch:
                    depth += 1
                elif c == open_:
                    depth -= 1
                    if depth == 0:
                        other = f"{pos}-{i}c"
                        break
        if other:
            t.tag_add("bracket", pos, f"{pos}+1c", other, f"{other}+1c")

    # ---- change tracking ----
    def _on_yscroll(self, first, last):
        self.sy.set(first, last)
        self.redraw_gutter()

    def _on_change(self):
        if self._lines_job is None:
            self._lines_job = self.text.after_idle(self._lines_idle)
        self.schedule_refresh(250)

    def _lines_idle(self):
        self._lines_job = None
        self.redraw_gutter()

    def _on_cursor(self):
        if self._cursor_job is None:
            self._cursor_job = self.text.after_idle(self._cursor_idle)

    def _cursor_idle(self):
        self._cursor_job = None
        self.match_brackets()
        if self.app.current() is self:
            self.app.update_status()

    def schedule_refresh(self, delay):
        if self._refresh_job:
            self.text.after_cancel(self._refresh_job)
        self._refresh_job = self.text.after(delay, self.refresh)

    def refresh(self):
        self._refresh_job = None
        self.highlight()
        content = self.content()
        self.chars = len(content)
        self.words = len(content.split())
        self.redraw_gutter()
        if self.app.current() is self:
            self.app.update_status()

    # ---- editing helpers ----
    def _on_return(self, event):
        if not self.app.auto_indent.get():
            return None
        t = self.text
        line = t.get("insert linestart", "insert")
        indent = re.match(r"[ \t]*", line).group(0)
        openers = AUTO_INDENT_OPENERS.get(self.lang)
        if openers and line.rstrip().endswith(openers):
            indent += "\t" if indent.startswith("\t") else "    "
        if t.tag_ranges("sel"):
            t.delete("sel.first", "sel.last")
        t.insert("insert", "\n" + indent)
        t.see("insert")
        return "break"

    def _gutter_wheel(self, event):
        self.text.yview_scroll(-3 if event.delta > 0 else 3, "units")
        return "break"

    def destroy(self):
        for job in (self._refresh_job, self._lines_job, self._cursor_job):
            if job:
                try:
                    self.text.after_cancel(job)
                except tk.TclError:
                    pass
        self.text.on_change = self.text.on_cursor = None
        self.frame.destroy()


class Notepad:
    def __init__(self, root):
        self.root = root
        self.cfg = load_config()
        self.docs = {}
        self._untitled = 0
        self._checking = False
        self.find_win = None
        self.aqua = root.tk.call("tk", "windowingsystem") == "aqua"

        theme = self.cfg["theme"] if self.cfg["theme"] in THEMES else "Blue"
        self.theme = THEMES[theme]
        self.font_size = self._clamp(self.cfg["font_size"])
        self.font = tkfont.Font(root, family=self.cfg["font_family"], size=self.font_size)

        self.wrap = tk.BooleanVar(value=self.cfg["wrap"])
        self.auto_indent = tk.BooleanVar(value=self.cfg["auto_indent"])
        self.line_numbers = tk.BooleanVar(value=self.cfg["line_numbers"])
        self.highlight = tk.BooleanVar(value=self.cfg["highlight"])
        self.theme_var = tk.StringVar(value=theme)
        self.enc_var = tk.StringVar(value="utf-8")
        self.eol_var = tk.StringVar(value=EOL_NAMES[DEFAULT_EOL])
        self.find_var = tk.StringVar()
        self.replace_var = tk.StringVar()
        self.opt_case = tk.BooleanVar(value=self.cfg["match_case"])
        self.opt_word = tk.BooleanVar(value=self.cfg["whole_word"])
        self.opt_regex = tk.BooleanVar(value=self.cfg["regex"])

        try:
            root.geometry(self.cfg["geometry"])
        except tk.TclError:
            root.geometry("900x600")
        if self.cfg.get("maximized"):
            try:
                root.state("zoomed")
            except tk.TclError:
                pass

        self._set_icon()
        self._build_shortcuts()
        self._build_menu()
        self._build_context_menu()
        self._build_status_bar()
        self._build_notebook()
        self._apply_chrome_theme()
        self.bind_shortcuts(root)
        root.protocol("WM_DELETE_WINDOW", self.exit)

    # ================= setup =================
    @staticmethod
    def _clamp(size):
        try:
            return max(MIN_SIZE, min(MAX_SIZE, int(size)))
        except (TypeError, ValueError):
            return DEFAULT_SIZE

    def _set_icon(self):
        icon = tk.PhotoImage(width=32, height=32)
        icon.put("{#C0C0C0}", to=(4, 1, 28, 31))
        icon.put("{" + BG + "}", to=(5, 2, 27, 30))
        icon.put("{#FFFF55}", to=(5, 2, 27, 5))
        for y, end in ((9, 24), (13, 22), (17, 24), (21, 19), (25, 23)):
            icon.put("{" + FG + "}", to=(8, y, end, y + 2))
        self.icon = icon
        self.root.iconphoto(True, icon)

    def _build_shortcuts(self):
        keys = [
            ("<Control-n>", self.new_tab),
            ("<Control-o>", self.open_file),
            ("<Control-s>", self.save),
            ("<Control-Shift-S>", self.save_as),
            ("<Control-p>", self.print_file),
            ("<Control-w>", self.close_tab),
            ("<Control-q>", self.exit),
            ("<Control-y>", lambda: self._text_event("<<Redo>>")),
            ("<Control-Shift-Z>", lambda: self._text_event("<<Redo>>")),
            ("<Control-a>", self.select_all),
            ("<Control-f>", lambda: self.show_find(False)),
            ("<Control-h>", lambda: self.show_find(True)),
            ("<F3>", self.find_next),
            ("<Shift-F3>", self.find_prev),
            ("<Control-g>", self.goto_line),
            ("<F5>", self.insert_datetime),
            ("<Control-plus>", lambda: self.zoom(1)),
            ("<Control-equal>", lambda: self.zoom(1)),
            ("<Control-KP_Add>", lambda: self.zoom(1)),
            ("<Control-minus>", lambda: self.zoom(-1)),
            ("<Control-KP_Subtract>", lambda: self.zoom(-1)),
            ("<Control-0>", self.reset_zoom),
            ("<Control-Tab>", lambda: self.cycle_tab(1)),
            ("<Control-Shift-Tab>", lambda: self.cycle_tab(-1)),
            ("<Control-ISO_Left_Tab>", lambda: self.cycle_tab(-1)),
        ]
        self.shortcuts = []
        for seq, func in keys:
            self.shortcuts.append((seq, func))
            m = re.fullmatch(r"<Control-([a-z])>", seq)
            if m:  # also works with Caps Lock on
                self.shortcuts.append((f"<Control-{m.group(1).upper()}>", func))

    def bind_shortcuts(self, widget):
        for seq, func in self.shortcuts:
            try:
                widget.bind(seq, lambda e, f=func: (f(), "break")[1])
            except tk.TclError:
                pass

    def _build_menu(self):
