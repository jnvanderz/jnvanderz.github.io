def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            cfg.update(data)
    except (OSError, ValueError):
        pass
    return cfg


def decode_bytes(data, forced=None):
    """Return (text, encoding). BOMs are detected first; latin-1 always succeeds."""
    if forced:
        return data.decode(forced, errors="replace"), forced
    if data.startswith(codecs.BOM_UTF8):
        return data[len(codecs.BOM_UTF8):].decode("utf-8", errors="replace"), "utf-8-sig"
    if data.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
        return data.decode("utf-16", errors="replace"), "utf-16"
    for enc in ("utf-8", "cp1252"):
        try:
            return data.decode(enc), enc
        except UnicodeDecodeError:
            continue
    return data.decode("latin-1"), "latin-1"


def looks_binary(data):
    if data.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
        return False
    return b"\x00" in data[:8192]


def detect_eol(text):
    if "\r\n" in text:
        return "\r\n"
    if "\r" in text:
        return "\r"
    if "\n" in text:
        return "\n"
    return DEFAULT_EOL


def make_indexer(content):
    """Return a function that converts a character offset into a Tk text index."""
    starts = [0]
    pos = content.find("\n")
    while pos != -1:
        starts.append(pos + 1)
        pos = content.find("\n", pos + 1)

    def index(offset):
        line = bisect.bisect_right(starts, offset) - 1
        return f"{line + 1}.{offset - starts[line]}"
    return index


def selected_lines(widget):
    """First and last line covered by the selection, or the cursor line."""
    if widget.tag_ranges("sel"):
        first = int(widget.index("sel.first").split(".")[0])
        last_index = widget.index("sel.last")
        last = int(last_index.split(".")[0])
        if last > first and last_index.endswith(".0"):
            last -= 1
        return first, last
    line = int(widget.index("insert").split(".")[0])
    return line, line


