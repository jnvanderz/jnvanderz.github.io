        m.add_command(label="Find...", accelerator="Ctrl+F", command=lambda: self.show_find(False))
        m.add_command(label="Replace...", accelerator="Ctrl+H", command=lambda: self.show_find(True))
        m.add_command(label="Find Next", accelerator="F3", command=self.find_next)
