    # ================= setup =================
    @staticmethod
    def _clamp(size):
        try:
            return max(MIN_SIZE, min(MAX_SIZE, int(size)))
        except (TypeError, ValueError):
            return DEFAULT_SIZE

    def _set_icon(self):
        icon = tk.PhotoImage(width=32, height=32)
        icon.put("{#C0C0C0}", to=(4, 1, 28, 31))
        icon.put("{" + BG + "}", to=(5, 2, 27, 30))
        icon.put("{#FFFF55}", to=(5, 2, 27, 5))
        for y, end in ((9, 24), (13, 22), (17, 24), (21, 19), (25, 23)):
            icon.put("{" + FG + "}", to=(8, y, end, y + 2))
        self.icon = icon
        self.root.iconphoto(True, icon)

    def _build_shortcuts(self):
        redo = lambda: self._text_event("<<Redo>>")
        keys = [
            ("<Control-n>", self.new_tab), ("<Control-o>", self.open_file),
            ("<Control-s>", self.save), ("<Control-Shift-S>", self.save_as),
            ("<Control-Alt-s>", self.save_all), ("<Control-p>", self.print_file),
            ("<Control-w>", self.close_tab), ("<Control-q>", self.exit),
            ("<Control-y>", redo), ("<Control-Shift-Z>", redo),
            ("<Control-a>", self.select_all),
            ("<Control-f>", lambda: self.show_find(False)),
            ("<Control-h>", lambda: self.show_find(True)),
            ("<F3>", self.find_next), ("<Shift-F3>", self.find_prev),
            ("<Control-g>", self.goto_line), ("<F5>", self.insert_datetime),
            ("<Control-slash>", self.toggle_comment), ("<Control-KP_Divide>", self.toggle_comment),
            ("<Control-d>", self.duplicate_line),
            ("<Alt-Up>", lambda: self.move_lines(-1)), ("<Alt-Down>", lambda: self.move_lines(1)),
            ("<Control-Shift-K>", self.delete_line), ("<Control-space>", self.autocomplete),
            ("<Control-F2>", self.toggle_bookmark), ("<F2>", lambda: self.goto_bookmark(1)),
            ("<Shift-F2>", lambda: self.goto_bookmark(-1)),
            ("<Control-Shift-U>", lambda: self.change_case("upper")),
            ("<Control-Shift-L>", lambda: self.change_case("lower")),
            ("<Control-Shift-F>", self.find_in_folder), ("<Control-backslash>", self.toggle_split),
            ("<F11>", self.toggle_fullscreen), ("<Shift-F11>", self.toggle_zen),
            ("<Control-Shift-P>", self.command_palette), ("<Control-r>", self.run_file),
            ("<Control-Shift-V>", self.preview),
            ("<Control-plus>", lambda: self.zoom(1)), ("<Control-equal>", lambda: self.zoom(1)),
            ("<Control-KP_Add>", lambda: self.zoom(1)), ("<Control-minus>", lambda: self.zoom(-1)),
            ("<Control-KP_Subtract>", lambda: self.zoom(-1)), ("<Control-0>", self.reset_zoom),
            ("<Control-Tab>", lambda: self.cycle_tab(1)),
            ("<Control-Shift-Tab>", lambda: self.cycle_tab(-1)),
            ("<Control-ISO_Left_Tab>", lambda: self.cycle_tab(-1)),
        ]
        self.shortcuts = []
        for seq, func in keys:
            self.shortcuts.append((seq, func))
            m = re.fullmatch(r"<Control-([a-z])>", seq)
            if m:  # also works with Caps Lock on
                self.shortcuts.append((f"<Control-{m.group(1).upper()}>", func))

    def bind_shortcuts(self, widget):
        for seq, func in self.shortcuts:
            try:
                widget.bind(seq, lambda e, f=func: (f(), "break")[1])
            except tk.TclError:
                pass

    def _build_menu(self):
        self.palette_items = []
        mb = tk.Menu(self.root)
        self.menubar = mb

        def cascade(label):
            menu = tk.Menu(mb, tearoff=0)
            mb.add_cascade(label=label, menu=menu)
            return menu

        def submenu(menu, label):
            sub = tk.Menu(menu, tearoff=0)
            menu.add_cascade(label=label, menu=sub)
            return sub

        def cmd(menu, cat, label, func, accel=""):
            menu.add_command(label=label, accelerator=accel, command=func)
            self.palette_items.append((f"{cat}: {label}", func, accel))

        def check(menu, cat, label, var, func, accel=""):
            menu.add_checkbutton(label=label, variable=var, command=func, accelerator=accel)

            def flip(v=var, f=func):
                v.set(not v.get())
                f()
            self.palette_items.append((f"{cat}: {label}", flip, accel))

        def radio(menu, cat, group, label, var, value, func):
            menu.add_radiobutton(label=label, value=value, variable=var, command=func)

            def pick(v=var, val=value, f=func):
                v.set(val)
                f()
            self.palette_items.append((f"{cat}: {group}: {label}", pick, ""))

        C = "File"
        m = cascade(C)
        cmd(m, C, "New Tab", self.new_tab, "Ctrl+N")
        cmd(m, C, "Open...", self.open_file, "Ctrl+O")
        self.recent_menu = submenu(m, "Open Recent")
        cmd(m, C, "Reload from Disk", self.reload)
        m.add_separator()
        cmd(m, C, "Save", self.save, "Ctrl+S")
        cmd(m, C, "Save As...", self.save_as, "Ctrl+Shift+S")
        cmd(m, C, "Save All", self.save_all, "Ctrl+Alt+S")
        m.add_separator()
        cmd(m, C, "Compare With...", self.compare_with)
        cmd(m, C, "Find in Folder...", self.find_in_folder, "Ctrl+Shift+F")
        m.add_separator()
        cmd(m, C, "Print...", self.print_file, "Ctrl+P")
        check(m, C, "Restore Session on Startup", self.restore_session, self.save_config)
        m.add_separator()
        cmd(m, C, "Close Tab", self.close_tab, "Ctrl+W")
        cmd(m, C, "Close Other Tabs", self.close_other_tabs)
        cmd(m, C, "Close All Tabs", self.close_all_tabs)
        cmd(m, C, "Exit", self.exit, "Ctrl+Q")
        self._rebuild_recent()

        C = "Edit"
        m = cascade(C)
        cmd(m, C, "Undo", lambda: self._text_event("<<Undo>>"), "Ctrl+Z")
        cmd(m, C, "Redo", lambda: self._text_event("<<Redo>>"), "Ctrl+Y")
        m.add_separator()
        cmd(m, C, "Cut", lambda: self._text_event("<<Cut>>"), "Ctrl+X")
        cmd(m, C, "Copy", lambda: self._text_event("<<Copy>>"), "Ctrl+C")
        cmd(m, C, "Paste", lambda: self._text_event("<<Paste>>"), "Ctrl+V")
        cmd(m, C, "Select All", self.select_all, "Ctrl+A")
        m.add_separator()
        cmd(m, C, "Find...", lambda: self.show_find(False), "Ctrl+F")
        cmd(m, C, "Replace...", lambda: self.show_find(True), "Ctrl+H")
        cmd(m, C, "Find Next", self.find_next, "F3")
        cmd(m, C, "Find Previous", self.find_prev, "Shift+F3")
        cmd(m, C, "Go To Line...", self.goto_line, "Ctrl+G")
        m.add_separator()
        cmd(m, C, "Toggle Comment", self.toggle_comment, "Ctrl+/")
        cmd(m, C, "Duplicate Line", self.duplicate_line, "Ctrl+D")
        cmd(m, C, "Move Line Up", lambda: self.move_lines(-1), "Alt+Up")
        cmd(m, C, "Move Line Down", lambda: self.move_lines(1), "Alt+Down")
        cmd(m, C, "Delete Line", self.delete_line, "Ctrl+Shift+K")
        cmd(m, C, "Indent", lambda: self.indent_cmd(False), "Tab")
        cmd(m, C, "Unindent", lambda: self.indent_cmd(True), "Shift+Tab")
        cmd(m, C, "Autocomplete", self.autocomplete, "Ctrl+Space")
        m.add_separator()
        sub = submenu(m, "Bookmarks")
